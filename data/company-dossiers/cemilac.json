  "faq": [
    {
      "question": "What is CEMILAC?",
      "answer": "CEMILAC is DRDO's military airworthiness certification body. It issues Release to Service (RTS) documents for IAF aircraft and certifies UAVs, airborne stores, and aero-engines.",
      "sources": [
        "src-01",
        "src-02"
      ]
    },
    {
      "question": "Is CEMILAC the same as DGCA?",
      "answer": "No. DGCA regulates civilian aviation; CEMILAC regulates military aviation airworthiness. Both fall under different ministries (DGCA under MoCA; CEMILAC under DRDO/MoD).",
      "sources": [
        "src-01",
        "src-02"
      ]
    }
  ],
