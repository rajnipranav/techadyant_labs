  "what_it_is": {
    "prose": "CEMILAC is DRDO's lead laboratory for military aircraft airworthiness certification. It issues Release to Service (RTS) documents for IAF aircraft and military certification for HAL-built aircraft (LCA Tejas, Su-30MKI upgrade, HTT-40, ALH Dhruv). CEMILAC also certifies UAVs, airborne stores, and aero-engines. CEMILAC is the Indian equivalent of FAA/EASA military certification.",
    "sources": [
      "src-01",
      "src-02",
      "src-03"
    ]
  },
