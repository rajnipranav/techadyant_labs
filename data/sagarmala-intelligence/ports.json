  "non_major_system": {
    "text": "217 notified non-major ports across the coastal states and UTs; 69 under 11 state maritime boards/directorates report on the Port Data Monitoring Platform. Non-major ports handled 742.41 MT in FY 2024-25 (747.71 MT provisional alternative) and 753.07 MMT in FY 2025-26 (advance). Gujarat alone accounted for 487.73 MT (65.70%) in FY25. All-ports (major + non-major) throughput was 1,597.27 MT in FY25 — major ports 53.52%.",
    "evidence": "fact",
    "provenance": [
      {
        "source_id": "src:shipmin-bps-2024-25"
      },
      {
        "source_id": "src:shipmin-nonmajor-march2026"
      }
    ]
  }
